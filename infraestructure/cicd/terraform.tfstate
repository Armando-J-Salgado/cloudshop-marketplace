          "attributes": {
            "id": "2826181585",
            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"S3FrontendYArtefactos\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"s3:PutObject\",\n        \"s3:PutEncryptionConfiguration\",\n        \"s3:PutBucketWebsite\",\n        \"s3:PutBucketVersioning\",\n        \"s3:PutBucketTagging\",\n        \"s3:PutBucketPublicAccessBlock\",\n        \"s3:PutBucketPolicy\",\n        \"s3:ListBucket\",\n        \"s3:GetObject\",\n        \"s3:GetEncryptionConfiguration\",\n        \"s3:GetBucketWebsite\",\n        \"s3:GetBucketVersioning\",\n        \"s3:GetBucketTagging\",\n        \"s3:GetBucketPublicAccessBlock\",\n        \"s3:GetBucketPolicy\",\n        \"s3:GetBucketLocation\",\n        \"s3:DeleteObject\",\n        \"s3:DeleteBucket\",\n        \"s3:CreateBucket\"\n      ],\n      \"Resource\": [\n        \"arn:aws:s3:::cloudshop-*/*\",\n        \"arn:aws:s3:::cloudshop-*\"\n      ]\n    },\n    {\n      \"Sid\": \"DynamoDBTablasDelProyecto\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"dynamodb:UpdateTimeToLive\",\n        \"dynamodb:UpdateTable\",\n        \"dynamodb:UpdateContinuousBackups\",\n        \"dynamodb:UntagResource\",\n        \"dynamodb:TagResource\",\n        \"dynamodb:ListTagsOfResource\",\n        \"dynamodb:DescribeTimeToLive\",\n        \"dynamodb:DescribeTable\",\n        \"dynamodb:DescribeContinuousBackups\",\n        \"dynamodb:DeleteTable\",\n        \"dynamodb:CreateTable\"\n      ],\n      \"Resource\": \"arn:aws:dynamodb:us-east-1:511949652182:table/cloudshop-*\"\n    },\n    {\n      \"Sid\": \"CloudFrontYWaf\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"wafv2:UpdateWebACL\",\n        \"wafv2:TagResource\",\n        \"wafv2:ListWebACLs\",\n        \"wafv2:ListTagsForResource\",\n        \"wafv2:GetWebACL\",\n        \"wafv2:DisassociateWebACL\",\n        \"wafv2:DeleteWebACL\",\n        \"wafv2:CreateWebACL\",\n        \"wafv2:AssociateWebACL\",\n        \"cloudfront:UpdateOriginAccessControl\",\n        \"cloudfront:UpdateDistribution\",\n        \"cloudfront:UntagResource\",\n        \"cloudfront:TagResource\",\n        \"cloudfront:ListDistributions\",\n        \"cloudfront:GetOriginAccessControl\",\n        \"cloudfront:GetDistributionConfig\",\n        \"cloudfront:GetDistribution\",\n        \"cloudfront:GetCachePolicy\",\n        \"cloudfront:DeleteOriginAccessControl\",\n        \"cloudfront:DeleteDistribution\",\n        \"cloudfront:DeleteCachePolicy\",\n        \"cloudfront:CreateOriginAccessControl\",\n        \"cloudfront:CreateDistribution\",\n        \"cloudfront:CreateCachePolicy\"\n      ],\n      \"Resource\": \"*\"\n    },\n    {\n      \"Sid\": \"SesDelProyecto\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"ses:VerifyEmailIdentity\",\n        \"ses:VerifyDomainIdentity\",\n        \"ses:UpdateTemplate\",\n        \"ses:UntagResource\",\n        \"ses:TagResource\",\n        \"ses:SetIdentityMailFromDomain\",\n        \"ses:GetTemplate\",\n        \"ses:GetIdentityVerificationAttributes\",\n        \"ses:DeleteTemplate\",\n        \"ses:DeleteIdentity\",\n        \"ses:CreateTemplate\"\n      ],\n      \"Resource\": \"*\"\n    },\n    {\n      \"Sid\": \"CognitoDelProyecto\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"cognito-idp:UpdateUserPoolClient\",\n        \"cognito-idp:UpdateUserPool\",\n        \"cognito-idp:UntagResource\",\n        \"cognito-idp:TagResource\",\n        \"cognito-idp:GetGroup\",\n        \"cognito-idp:DescribeUserPoolClient\",\n        \"cognito-idp:DescribeUserPool\",\n        \"cognito-idp:DeleteUserPoolClient\",\n        \"cognito-idp:DeleteUserPool\",\n        \"cognito-idp:DeleteGroup\",\n        \"cognito-idp:CreateUserPoolClient\",\n        \"cognito-idp:CreateUserPool\",\n        \"cognito-idp:CreateGroup\"\n      ],\n      \"Resource\": \"arn:aws:cognito-idp:us-east-1:511949652182:userpool/*\"\n    }\n  ]\n}",
            "minified_json": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Sid\":\"S3FrontendYArtefactos\",\"Effect\":\"Allow\",\"Action\":[\"s3:PutObject\",\"s3:PutEncryptionConfiguration\",\"s3:PutBucketWebsite\",\"s3:PutBucketVersioning\",\"s3:PutBucketTagging\",\"s3:PutBucketPublicAccessBlock\",\"s3:PutBucketPolicy\",\"s3:ListBucket\",\"s3:GetObject\",\"s3:GetEncryptionConfiguration\",\"s3:GetBucketWebsite\",\"s3:GetBucketVersioning\",\"s3:GetBucketTagging\",\"s3:GetBucketPublicAccessBlock\",\"s3:GetBucketPolicy\",\"s3:GetBucketLocation\",\"s3:DeleteObject\",\"s3:DeleteBucket\",\"s3:CreateBucket\"],\"Resource\":[\"arn:aws:s3:::cloudshop-*/*\",\"arn:aws:s3:::cloudshop-*\"]},{\"Sid\":\"DynamoDBTablasDelProyecto\",\"Effect\":\"Allow\",\"Action\":[\"dynamodb:UpdateTimeToLive\",\"dynamodb:UpdateTable\",\"dynamodb:UpdateContinuousBackups\",\"dynamodb:UntagResource\",\"dynamodb:TagResource\",\"dynamodb:ListTagsOfResource\",\"dynamodb:DescribeTimeToLive\",\"dynamodb:DescribeTable\",\"dynamodb:DescribeContinuousBackups\",\"dynamodb:DeleteTable\",\"dynamodb:CreateTable\"],\"Resource\":\"arn:aws:dynamodb:us-east-1:511949652182:table/cloudshop-*\"},{\"Sid\":\"CloudFrontYWaf\",\"Effect\":\"Allow\",\"Action\":[\"wafv2:UpdateWebACL\",\"wafv2:TagResource\",\"wafv2:ListWebACLs\",\"wafv2:ListTagsForResource\",\"wafv2:GetWebACL\",\"wafv2:DisassociateWebACL\",\"wafv2:DeleteWebACL\",\"wafv2:CreateWebACL\",\"wafv2:AssociateWebACL\",\"cloudfront:UpdateOriginAccessControl\",\"cloudfront:UpdateDistribution\",\"cloudfront:UntagResource\",\"cloudfront:TagResource\",\"cloudfront:ListDistributions\",\"cloudfront:GetOriginAccessControl\",\"cloudfront:GetDistributionConfig\",\"cloudfront:GetDistribution\",\"cloudfront:GetCachePolicy\",\"cloudfront:DeleteOriginAccessControl\",\"cloudfront:DeleteDistribution\",\"cloudfront:DeleteCachePolicy\",\"cloudfront:CreateOriginAccessControl\",\"cloudfront:CreateDistribution\",\"cloudfront:CreateCachePolicy\"],\"Resource\":\"*\"},{\"Sid\":\"SesDelProyect