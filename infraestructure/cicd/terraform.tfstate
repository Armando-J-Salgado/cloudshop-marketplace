            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"LambdaFuncionesDelProyecto\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"lambda:UpdateFunctionConfiguration\",\n        \"lambda:UpdateFunctionCode\",\n        \"lambda:UpdateAlias\",\n        \"lambda:UntagResource\",\n        \"lambda:TagResource\",\n        \"lambda:RemovePermission\",\n        \"lambda:PutFunctionConcurrency\",\n        \"lambda:PublishVersion\",\n        \"lambda:ListVersionsByFunction\",\n        \"lambda:ListTags\",\n        \"lambda:GetPolicy\",\n        \"lambda:GetFunctionConfiguration\",\n        \"lambda:GetFunction\",\n        \"lambda:GetAlias\",\n        \"lambda:DeleteFunctionConcurrency\",\n        \"lambda:DeleteFunction\",\n        \"lambda:DeleteAlias\",\n        \"lambda:CreateFunction\",\n        \"lambda:CreateAlias\",\n        \"lambda:AddPermission\"\n      ],\n      \"Resource\": \"arn:aws:lambda:us-east-1:511949652182:function:cloudshop-*\"\n    },\n    {\n      \"Sid\": \"ApiGatewayDelProyecto\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"apigateway:PUT\",\n        \"apigateway:POST\",\n        \"apigateway:PATCH\",\n        \"apigateway:GET\",\n        \"apigateway:DELETE\"\n      ],\n      \"Resource\": \"arn:aws:apigateway:us-east-1::*\"\n    },\n    {\n      \"Sid\": \"EventBridgeDelProyecto\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"events:UntagResource\",\n        \"events:TagResource\",\n        \"events:RemoveTargets\",\n        \"events:PutTargets\",\n        \"events:PutRule\",\n        \"events:ListTargetsByRule\",\n        \"events:DescribeRule\",\n        \"events:DescribeEventBus\",\n        \"events:DeleteRule\",\n        \"events:DeleteEventBus\",\n        \"events:CreateEventBus\"\n      ],\n      \"Resource\": [\n        \"arn:aws:events:us-east-1:511949652182:rule/cloudshop-*\",\n        \"arn:aws:events:us-east-1:511949652182:event-bus/cloudshop-*\"\n      ]\n    },\n    {\n      \"Sid\": \"CloudWatchLogsYAlarmasDelProyecto\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"logs:UntagResource\",\n        \"logs:TagResource\",\n        \"logs:TagLogGroup\",\n        \"logs:PutRetentionPolicy\",\n        \"logs:DeleteLogGroup\",\n        \"logs:CreateLogGroup\",\n        \"cloudwatch:UntagResource\",\n        \"cloudwatch:TagResource\",\n        \"cloudwatch:PutMetricAlarm\",\n        \"cloudwatch:PutDashboard\",\n        \"cloudwatch:GetDashboard\",\n        \"cloudwatch:DescribeAlarms\",\n        \"cloudwatch:DeleteDashboards\",\n        \"cloudwatch:DeleteAlarms\"\n      ],\n      \"Resource\": [\n        \"arn:aws:logs:us-east-1:511949652182:log-group:/aws/lambda/cloudshop-*\",\n        \"arn:aws:cloudwatch:us-east-1:511949652182:alarm:cloudshop-*\",\n        \"arn:aws:cloudwatch::511949652182:dashboard/cloudshop-*\"\n      ]\n    },\n    {\n      \"Sid\": \"SsmParametrosDelProyecto\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"ssm:PutParameter\",\n        \"ssm:ListTagsForResource\",\n        \"ssm:GetParameters\",\n        \"ssm:GetParameter\",\n        \"ssm:DescribeParameters\",\n        \"ssm:DeleteParameter\",\n        \"ssm:AddTagsToResource\"\n      ],\n      \"Resource\": \"arn:aws:ssm:us-east-1:511949652182:parameter/app/*\"\n    }\n  ]\n}",
            "minified_json": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Sid\":\"LambdaFuncionesDelProyecto\",\"Effect\":\"Allow\",\"Action\":[\"lambda:UpdateFunctionConfiguration\",\"lambda:UpdateFunctionCode\",\"lambda:UpdateAlias\",\"lambda:UntagResource\",\"lambda:TagResource\",\"lambda:RemovePermission\",\"lambda:PutFunctionConcurrency\",\"lambda:PublishVersion\",\"lambda:ListVersionsByFunction\",\"lambda:ListTags\",\"lambda:GetPolicy\",\"lambda:GetFunctionConfiguration\",\"lambda:GetFunction\",\"lambda:GetAlias\",\"lambda:DeleteFunctionConcurrency\",\"lambda:DeleteFunction\",\"lambda:DeleteAlias\",\"lambda:CreateFunction\",\"lambda:CreateAlias\",\"lambda:AddPermission\"],\"Resource\":\"arn:aws:lambda:us-east-1:511949652182:function:cloudshop-*\"},{\"Sid\":\"ApiGatewayDelProyecto\",\"Effect\":\"Allow\",\"Action\":[\"apigateway:PUT\",\"apigateway:POST\",\"apigateway:PATCH\",\"apigateway:GET\",\"apigateway:DELETE\"],\"Resource\":\"arn:aws:apigateway:us-east-1::*\"},{\"Sid\":\"EventBridgeDelProyecto\",\"Effect\":\"Allow\",\"Action\":[\"events:UntagResource\",\"events:TagResource\",\"events:RemoveTargets\",\"events:PutTargets\",\"events:PutRule\",\"events:ListTargetsByRule\",\"events:DescribeRule\",\"events:DescribeEventBus\",\"events:DeleteRule\",\"events:DeleteEventBus\",\"events:CreateEventBus\"],\"Resource\":[\"arn:aws:events:us-east-1:511949652182:rule/cloudshop-*\",\"arn:aws:events:us-east-1:511949652182:event-bus/cloudshop-*\"]},{\"Sid\":\"CloudWatchLogsYAlarmasDelProyecto\",\"Effect\":\"Allow\",\"Action\":[\"logs:UntagResource\",\"logs:TagResource\",\"logs:TagLogGroup\",\"logs:PutRetentionPolicy\",\"logs:DeleteLogGroup\",\"logs:CreateLogGroup\",\"cloudwatch:UntagResource\",\"cloudwatch:TagResource\",\"cloudwatch:PutMetricAlarm\",\"cloudwatch:PutDashboard\",\"cloudwatch:GetDashboard\",\"cloudwatch:DescribeAlarms\",\"cloudwatch:DeleteDashboards\",\"cloudwatch:DeleteAlarms\"],\"Resource\":[\"arn:aws:logs:us-east-1:511949652182:log-group:/aws/lambda/cloudsho