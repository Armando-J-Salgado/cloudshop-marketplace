            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"CrearRolesConBoundaryObligatorio\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"iam:PutRolePolicy\",\n        \"iam:PutRolePermissionsBoundary\",\n        \"iam:CreateRole\",\n        \"iam:AttachRolePolicy\"\n      ],\n      \"Resource\": \"arn:aws:iam::511949652182:role/cloudshop/*\",\n      \"Condition\": {\n        \"StringEquals\": {\n          \"iam:PermissionsBoundary\": \"arn:aws:iam::511949652182:policy/cicd/CloudShopWorkloadBoundary\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"GestionRolesDeAplicacion\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"iam:UpdateAssumeRolePolicy\",\n        \"iam:UntagRole\",\n        \"iam:TagRole\",\n        \"iam:ListRolePolicies\",\n        \"iam:ListAttachedRolePolicies\",\n        \"iam:GetRolePolicy\",\n        \"iam:GetRole\",\n        \"iam:DetachRolePolicy\",\n        \"iam:DeleteRolePolicy\",\n        \"iam:DeleteRole\"\n      ],\n      \"Resource\": \"arn:aws:iam::511949652182:role/cloudshop/*\"\n    },\n    {\n      \"Sid\": \"PassRoleSoloAServiciosDelProyecto\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"iam:PassRole\",\n      \"Resource\": \"arn:aws:iam::511949652182:role/cloudshop/*\",\n      \"Condition\": {\n        \"StringEquals\": {\n          \"iam:PassedToService\": [\n            \"lambda.amazonaws.com\",\n            \"apigateway.amazonaws.com\",\n            \"events.amazonaws.com\"\n          ]\n        }\n      }\n    },\n    {\n      \"Sid\": \"PoliticasGestionadasDelProyecto\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"iam:ListPolicyVersions\",\n        \"iam:ListEntitiesForPolicy\",\n        \"iam:GetPolicyVersion\",\n        \"iam:GetPolicy\",\n        \"iam:DeletePolicyVersion\",\n        \"iam:DeletePolicy\",\n        \"iam:CreatePolicyVersion\",\n        \"iam:CreatePolicy\"\n      ],\n      \"Resource\": \"arn:aws:iam::511949652182:policy/cloudshop/*\"\n    },\n    {\n      \"Sid\": \"DenyAutoEscalada\",\n      \"Effect\": \"Deny\",\n      \"Action\": \"iam:*\",\n      \"Resource\": [\n        \"arn:aws:iam::511949652182:user/cicd/*\",\n        \"arn:aws:iam::511949652182:role/cicd/*\",\n        \"arn:aws:iam::511949652182:policy/cicd/*\"\n      ]\n    },\n    {\n      \"Sid\": \"DenyQuitarBoundary\",\n      \"Effect\": \"Deny\",\n      \"Action\": \"iam:DeleteRolePermissionsBoundary\",\n      \"Resource\": \"*\"\n    }\n  ]\n}",
            "minified_json": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Sid\":\"CrearRolesConBoundaryObligatorio\",\"Effect\":\"Allow\",\"Action\":[\"iam:PutRolePolicy\",\"iam:PutRolePermissionsBoundary\",\"iam:CreateRole\",\"iam:AttachRolePolicy\"],\"Resource\":\"arn:aws:iam::511949652182:role/cloudshop/*\",\"Condition\":{\"StringEquals\":{\"iam:PermissionsBoundary\":\"arn:aws:iam::511949652182:policy/cicd/CloudShopWorkloadBoundary\"}}},{\"Sid\":\"GestionRolesDeAplicacion\",\"Effect\":\"Allow\",\"Action\":[\"iam:UpdateAssumeRolePolicy\",\"iam:UntagRole\",\"iam:TagRole\",\"iam:ListRolePolicies\",\"iam:ListAttachedRolePolicies\",\"iam:GetRolePolicy\",\"iam:GetRole\",\"iam:DetachRolePolicy\",\"iam:DeleteRolePolicy\",\"iam:DeleteRole\"],\"Resource\":\"arn:aws:iam::511949652182:role/cloudshop/*\"},{\"Sid\":\"PassRoleSoloAServiciosDelProyecto\",\"Effect\":\"Allow\",\"Action\":\"iam:PassRole\",\"Resource\":\"arn:aws:iam::511949652182:role/cloudshop/*\",\"Condition\":{\"StringEquals\":{\"iam:PassedToService\":[\"lambda.amazonaws.com\",\"apigateway.amazonaws.com\",\"events.amazonaws.com\"]}}},{\"Sid\":\"PoliticasGestionadasDelProyecto\",\"Effect\":\"Allow\",\"Action\":[\"iam:ListPolicyVersions\",\"iam:ListEntitiesForPolicy\",\"iam:GetPolicyVersion\",\"iam:GetPolicy\",\"iam:DeletePolicyVersion\",\"iam:DeletePolicy\",\"iam:CreatePolicyVersion\",\"iam:CreatePolicy\"],\"Resource\":\"arn:aws:iam::511949652182:policy/cloudshop/*\"},{\"Sid\":\"DenyAutoEscalada\",\"Effect\":\"Deny\",\"Action\":\"iam:*\",\"Resource\":[\"arn:aws:iam::511949652182:user/cicd/*\",\"arn:aws:iam::511949652182:role/cicd/*\",\"arn:aws:iam::511949652182:policy/cicd/*\"]},{\"Sid\":\"DenyQuitarBoundary\",\"Effect\":\"Deny\",\"Action\":\"iam:DeleteRolePermissionsBoundary\",\"Resource\":\"*\"}]}",
