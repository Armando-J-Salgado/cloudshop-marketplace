          "attributes": {
            "id": "963842268",
            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"PermisosDeEjecucionDeAplicacion\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"ses:SendTemplatedEmail\",\n        \"ses:SendRawEmail\",\n        \"ses:SendEmail\",\n        \"logs:PutLogEvents\",\n        \"logs:CreateLogStream\",\n        \"logs:CreateLogGroup\",\n        \"events:PutEvents\",\n        \"dynamodb:UpdateItem\",\n        \"dynamodb:Scan\",\n        \"dynamodb:Query\",\n        \"dynamodb:PutItem\",\n        \"dynamodb:GetItem\",\n        \"dynamodb:DeleteItem\"\n      ],\n      \"Resource\": \"*\"\n    },\n    {\n      \"Sid\": \"LecturaParametrosDeConfiguracion\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"ssm:GetParameters\",\n        \"ssm:GetParameter\"\n      ],\n      \"Resource\": \"arn:aws:ssm:*:*:parameter/app/*\"\n    },\n    {\n      \"Sid\": \"AdministracionDeUsuariosCognito\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"cognito-idp:ListUsers\",\n        \"cognito-idp:AdminUpdateUserAttributes\",\n        \"cognito-idp:AdminSetUserPassword\",\n        \"cognito-idp:AdminGetUser\",\n        \"cognito-idp:AdminDisableUser\",\n        \"cognito-idp:AdminDeleteUser\",\n        \"cognito-idp:AdminCreateUser\",\n        \"cognito-idp:AdminAddUserToGroup\"\n      ],\n      \"Resource\": \"arn:aws:cognito-idp:*:*:userpool/*\"\n    }\n  ]\n}",
            "minified_json": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Sid\":\"PermisosDeEjecucionDeAplicacion\",\"Effect\":\"Allow\",\"Action\":[\"ses:SendTemplatedEmail\",\"ses:SendRawEmail\",\"ses:SendEmail\",\"logs:PutLogEvents\",\"logs:CreateLogStream\",\"logs:CreateLogGroup\",\"events:PutEvents\",\"dynamodb:UpdateItem\",\"dynamodb:Scan\",\"dynamodb:Query\",\"dynamodb:PutItem\",\"dynamodb:GetItem\",\"dynamodb:DeleteItem\"],\"Resource\":\"*\"},{\"Sid\":\"LecturaParametrosDeConfiguracion\",\"Effect\":\"Allow\",\"Action\":[\"ssm:GetParameters\",\"ssm:GetParameter\"],\"Resource\":\"arn:aws:ssm:*:*:parameter/app/*\"},{\"Sid\":\"AdministracionDeUsuariosCognito\",\"Effect\":\"Allow\",\"Action\":[\"cognito-idp:ListUsers\",\"cognito-idp:AdminUpdateUserAttributes\",\"cognito-idp:AdminSetUserPassword\",\"cognito-idp:AdminGetUser\",\"cognito-idp:AdminDisableUser\",\"cognito-idp:AdminDeleteUser\",\"cognito-idp:AdminCreateUser\",\"cognito-idp:AdminAddUserToGroup\"],\"Resource\":\"arn:aws:cognito-idp:*:*:userpool/*\"}]}",
